{
  "name": "college-connect",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mobile:sync": "npm run mobile:check && npm run build:mobile && cap sync",
    "android:open": "cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "ios:open": "cap open ios",
    "ios:run": "npm run mobile:sync && cap run ios",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "mobile:check": "node scripts/mobile.mjs check",
    "android:debug": "node scripts/mobile.mjs android-debug",
    "android:release": "node scripts/mobile.mjs android-release",
    "build:mobile": "ng build --configuration production,mobile"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "browser-image-compression": "^2.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.17",
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.2",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
